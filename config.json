{
  "port": 8080,
  "host": "0.0.0.0",
  "webroot": "webroot",
  "liveReload": true,
  "domains": {
    "example.localhost": "sites/example"
  },
  "redirects": {
    "old.localhost": "https://example.com"
  },
  "blockFeature": true,
  "blockedFiles": ["*.env", "secret/*", "*.log"],
  "logsEnabled": true,
  "requestLogsEnabled": true,
  "debugLogsEnabled": false,
  "debugLogLevel": "info"
}
